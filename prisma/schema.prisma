generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  fullName            String
  fullName_normalized String     @default("") @db.Text
  password            String
  active              Boolean    @default(true)
  role                SystemRole
  passwordResetToken   String?    @db.Text
  passwordResetExpiresAt DateTime?
  passwordResetUsedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  healthProfessional HealthProfessional?
  participant        Participant?
  researcher         Researcher?
  notifications      Notification[]

  @@index([fullName_normalized])
  @@map("user")
}

model Researcher {
  id            String  @id @unique
  institutionId String
  fieldOfStudy  String?
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user        User       @relation(fields: [id], references: [id])
  institution HealthUnit @relation(fields: [institutionId], references: [id])

  @@index([institutionId])
  @@map("researcher")
}

/// Estabelecimento de saúde/pesquisa (referência, não isolamento).
/// cnesCode = Cadastro Nacional de Estabelecimentos de Saúde (SUS).
model HealthUnit {
  id              String  @id @default(uuid())
  name            String
  name_normalized String  @default("") @db.Text
  cnesCode        String? @unique
  type            String?
  city            String?
  state           String?
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  professionals HealthProfessional[]
  researchers   Researcher[]

  @@index([name_normalized])
  @@map("health_unit")
}

model HealthProfessional {
  id                    String  @id @unique
  active                Boolean @default(true)
  speciality            String
  speciality_normalized String  @default("") @db.Text

  /// Lotação (opcional para não travar cadastro).
  healthUnitId String?
  healthUnit   HealthUnit? @relation(fields: [healthUnitId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  appliedQuestionnaires QuestionnaireResponse[]
  user                  User @relation(fields: [id], references: [id])

  historicoBases         HistoricoBase[]
  shareRequestsMade      ShareRequest[] @relation("ShareRequestRequester")
  shareRequestsReceived  ShareRequest[] @relation("ShareRequestOwner")

  @@index([speciality])
  @@index([speciality_normalized])
  @@index([active])
  @@map("health_professional")
}

model Participant {
  id           String   @id @unique
  birthday     DateTime @db.Date
  weight       Int      @default(0)
  height       Int      @default(0)
  zipCode      String
  street       String
  number       String
  complement   String?
  city         String
  state        String
  neighborhood String
  active       Boolean  @default(true)
  gender       Gender

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  questionnaireResponses QuestionnaireResponse[]
  user                   User @relation(fields: [id], references: [id])

  historicoBases HistoricoBase[]
  shareRequests  ShareRequest[]

  @@map("participant")
}

/// Vínculo profissional↔participante + container do histórico do dono.
/// Substitui a antiga HealthProfessionalParticipant (mesmo grão).
model HistoricoBase {
  id String @id @default(uuid())

  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  ownerProfessionalId String
  ownerProfessional   HealthProfessional @relation(fields: [ownerProfessionalId], references: [id], onDelete: Cascade)

  origin HistoricoOrigin @default(FROM_SCRATCH)
  active Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  responses             QuestionnaireResponse[]
  shareRequestsAsSource ShareRequest[]          @relation("ShareRequestSource")
  shareRequestsAsTarget ShareRequest[]          @relation("ShareRequestTarget")

  @@unique([participantId, ownerProfessionalId])
  @@index([ownerProfessionalId])
  @@map("historico_base")
}

/// Solicitação de cópia de base histórica (opt-in do fluxograma).
/// Invariante de aplicação: no máximo uma PENDING por (requester, source).
model ShareRequest {
  id String @id @default(uuid())

  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  requesterProfessionalId String
  requesterProfessional   HealthProfessional @relation("ShareRequestRequester", fields: [requesterProfessionalId], references: [id], onDelete: Cascade)

  ownerProfessionalId String
  ownerProfessional   HealthProfessional @relation("ShareRequestOwner", fields: [ownerProfessionalId], references: [id], onDelete: Cascade)

  sourceHistoricoBaseId String
  sourceHistoricoBase   HistoricoBase @relation("ShareRequestSource", fields: [sourceHistoricoBaseId], references: [id], onDelete: Cascade)

  /// Base criada para o solicitante quando o pedido é aprovado.
  targetHistoricoBaseId String?
  targetHistoricoBase   HistoricoBase? @relation("ShareRequestTarget", fields: [targetHistoricoBaseId], references: [id])

  status ShareRequestStatus @default(PENDING)

  /// Corte temporal da cópia: só respostas com date <= snapshotAt são copiadas.
  snapshotAt  DateTime
  requestedAt DateTime  @default(now())
  respondedAt DateTime?

  notifications Notification[]

  @@index([ownerProfessionalId, status])
  @@index([requesterProfessionalId, status])
  @@index([participantId])
  @@map("share_request")
}

model Notification {
  id String @id @default(uuid())

  recipientUserId String
  recipient       User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?          @db.Text

  /// Ponteiro genérico para a entidade que originou a notificação.
  entityType String?
  entityId   String?

  shareRequestId String?
  shareRequest   ShareRequest? @relation(fields: [shareRequestId], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientUserId, readAt])
  @@index([recipientUserId, createdAt])
  @@map("notification")
}

model Questionnaire {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  description String? @db.Text
  active      Boolean @default(true)
  version     String  @default("1.0")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups    QuestionGroup[]
  responses QuestionnaireResponse[]

  @@map("questionnaire")
}

model QuestionGroup {
  id          String  @id @default(uuid())
  title       String
  order       Int
  description String? @db.Text

  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  subGroups QuestionSubGroup[]
  questions Question[]

  @@index([questionnaireId])
  @@map("question_group")
}

model QuestionSubGroup {
  id          String  @id @default(uuid())
  title       String
  order       Int
  description String? @db.Text

  groupId String
  group   QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  questions Question[]

  @@index([groupId])
  @@map("question_subgroup")
}

model Question {
  id        String       @id @default(uuid())
  statement String       @db.Text
  order     Int
  type      QuestionType
  required  Boolean      @default(true)

  groupId String?
  group   QuestionGroup? @relation(fields: [groupId], references: [id])

  subGroupId String?
  subGroup   QuestionSubGroup? @relation(fields: [subGroupId], references: [id])

  options QuestionOption[]
  answers Answer[]

  @@map("question")
}

model QuestionOption {
  id    String @id @default(uuid())
  label String
  score Int    @default(0)
  order Int

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answers Answer[]

  @@index([questionId])
  @@map("question_option")
}

model QuestionnaireResponse {
  id String @id @default(uuid())

  totalScore     Int      @default(0)
  classification String?
  date           DateTime @default(now())

  /// Base histórica a que a resposta pertence (agrupamento primário).
  historicoBaseId String
  historicoBase   HistoricoBase @relation(fields: [historicoBaseId], references: [id], onDelete: Cascade)

  /// Denormalizado (= historicoBase.participantId) para dashboards/pesquisa.
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])

  /// Autoria original — numa cópia, difere do dono da base.
  appliedByProfessionalId String
  appliedByProfessional   HealthProfessional @relation(fields: [appliedByProfessionalId], references: [id])

  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])

  /// Linhagem: cópias apontam a resposta original. Análises populacionais
  /// devem filtrar sourceResponseId IS NULL para não contar duplicado.
  sourceResponseId String?
  sourceResponse   QuestionnaireResponse?  @relation("ResponseLineage", fields: [sourceResponseId], references: [id])
  copies           QuestionnaireResponse[] @relation("ResponseLineage")

  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([historicoBaseId])
  @@index([participantId])
  @@index([appliedByProfessionalId])
  @@index([sourceResponseId])
  @@map("questionnaire_response")
}

model Answer {
  id String @id @default(uuid())

  questionnaireResponseId String
  questionnaireResponse   QuestionnaireResponse @relation(fields: [questionnaireResponseId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  valueText String?

  @@index([questionnaireResponseId])
  @@map("answer")
}

enum QuestionType {
  TEXT
  NUMBER
  BOOLEAN
  MULTIPLE_CHOICE
  SCALE
}

enum SystemRole {
  MANAGER
  PARTICIPANT
  RESEARCHER
  HEALTH_PROFESSIONAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum HistoricoOrigin {
  FROM_SCRATCH
  COPIED
}

enum ShareRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  SHARE_REQUEST_RECEIVED
  SHARE_REQUEST_APPROVED
  SHARE_REQUEST_REJECTED
  SYSTEM
}
